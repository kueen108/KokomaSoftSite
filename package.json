{
  "name": "kokomasoft-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:game && astro build",
    "build:game": "npm ci --prefix games/dawnleaf-brigade --no-audit --no-fund && npm --prefix games/dawnleaf-brigade run build -- --base /games/dawnleaf-brigade/ --outDir ../../public/games/dawnleaf-brigade --emptyOutDir",
    "harness:curated": "node scripts/run-curated-knowledge-digest.mjs --harness --workflow all --date today --projection-days 30",
    "harness:medium": "node scripts/generate-medium-digest.mjs --harness --date today",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.3.0",
    "astro": "^5.7.0",
    "d3-geo": "^3.1.1",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/topojson-client": "^3.1.5"
  }
}
